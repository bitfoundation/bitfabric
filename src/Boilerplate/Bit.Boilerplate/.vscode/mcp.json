{
    "servers": {
        "bitfabric-docs": {
            "type": "http",
            "url": "https://api.bitfabric.co/docs-mcp"
        },
        "dev-mcp-test": {
            "type": "http",
            "url": "https://use-your-test-api-server-url-here.com/dev-mcp"
        },
        "dev-mcp-production": {
            "type": "http",
            "url": "https://use-your-api-server-url-here.com/dev-mcp"
        },
        "bitfabric": {
            "type": "http",
            "url": "https://api.bitfabric.co/mcp"
        },
        "aspire": {
            "type": "stdio",
            "command": "aspire",
            "args": [
                "agent",
                "mcp"
            ]
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest",
                "--output-dir",
                "${workspaceFolder}/.playwright-mcp",
                "--output-max-size",
                "52428800"
            ]
        }
    }
}
