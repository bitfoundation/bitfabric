@*+:cnd:noEmit*@
@attribute [Route(PageUrls.Home)]
@attribute [Route("{culture:nonfile?}" + PageUrls.Home)]
@attribute [AppResponseCache(SharedMaxAge = 3600 * 24, MaxAge = 60 * 5)]
@inherits AppPageBase

<AppPageData Title="@Localizer[nameof(AppStrings.Home)]"
             PageTitle="@Localizer[nameof(AppStrings.HomePageTitle)]">
    <Head>
        <script type="application/ld+json">@((MarkupString)BuildSiteJsonLd())</script>
    </Head>
</AppPageData>

<section>
    <BitStack Alignment="BitAlignment.Center" Gap="2rem" Class="root-stack">
        @*#if (framework == 'net11.0')*@
        @if (IsKiosk)
        {
            <BitMessage Multiline Color="BitColor.Warning" Title="@Localizer[nameof(AppStrings.KioskTitle)]">
                <Content>
                    @Localizer[nameof(AppStrings.KioskMessage)]
                </Content>
                <Actions>
                    <BitButton Color="BitColor.PrimaryBackground" OnClick="WrapHandled(ExitApp)">
                        @Localizer[nameof(AppStrings.KioskExitApp)]
                    </BitButton>
                </Actions>
            </BitMessage>
        }
        @*#endif*@

        <BitText Typography="BitTypography.H4" Align="BitTextAlign.Center">
            @Localizer[nameof(AppStrings.HomePanelTitle)]
            <br />
            @Localizer[nameof(AppStrings.HomePanelSubtitle)]
        </BitText>

        <BitText Typography="BitTypography.H6" Align="BitTextAlign.Center">
            @Localizer[nameof(AppStrings.HomeMessage)]
        </BitText>

        @*#if (multitenant == true && module != "Sales")*@
        <AuthorizeView Policy="@AuthPolicies.TENANT_SELECTED">
            <NotAuthorized>
                <BitCard FullWidth Style="padding:2rem">
                    <BitStack HorizontalAlign="BitAlignment.Center">
                        <BitIcon IconName="@BitIconName.Org" Color="BitColor.Primary" />
                        <BitText Typography="BitTypography.H6" Align="BitTextAlign.Center">
                            @Localizer[nameof(AppStrings.SelectTenantMessage)]
                        </BitText>
                        <BitButton Href="@CultureInfoManager.GetCurrentCultureUrl(PageUrls.ManageMyTenants)">
                            @Localizer[nameof(AppStrings.ManageMyTenants)]
                        </BitButton>
                    </BitStack>
                </BitCard>
            </NotAuthorized>
        </AuthorizeView>
        @*#endif*@

        @*#if (module == "Sales")*@
        @*#if (signalR == true)*@
        <BitSearchBox ReadOnly
                      Underlined
                      ShowSearchButton
                      Style="width:80%"
                      Color="BitColor.Secondary"
                      AriaLabel="@Localizer[nameof(AppStrings.SearchProducts)]"
                      Placeholder="@Localizer[nameof(AppStrings.SearchProducts)]"
                      OnSearch="WrapHandled(HandleOnSearchBoxClick)"
                      @onclick="WrapHandled(HandleOnSearchBoxClick)" />
        @*#endif*@

        <ProductsCarousel />
        <br />
        <ProductsSection />
        @*#endif*@

        @*#if (module != "Sales")*@
        <CascadingValue Value="BitDir.Ltr">
            <BitCard FullWidth Style="padding:2rem">
                <BitStack>
                    <BitText Typography="BitTypography.H5">Statistics</BitText>
                    <BitPivot Style="width:100%" Styles="@(new() { Body = "overflow:auto" })" OnChange="HandleOnPivotChange">
                        <BitPivotItem HeaderText="Nuget">
                            @if (isLoadingNuget)
                            {
                                <BitStack HorizontalAlign="BitAlignment.Center">
                                    <BitRippleLoading />
                                </BitStack>
                            }
                            else if (nugetStats?.Data is { Count: > 0 })
                            {
                                var data = nugetStats.Data[0];
                                <BitStack>
                                    <BitStack Horizontal>
                                        <BitText>Package id:</BitText>
                                        <BitText><b>@data.Id</b></BitText>
                                    </BitStack>
                                    <BitStack Horizontal>
                                        <BitText>Version:</BitText>
                                        <BitText><b>@data.Version</b></BitText>
                                    </BitStack>
                                    <BitStack Horizontal>
                                        <BitText>Total downloads:</BitText>
                                        <BitText><b>@data.TotalDownloads.ToString("N0")</b></BitText>
                                    </BitStack>
                                </BitStack>
                            }
                            else
                            {
                                <BitText Typography="BitTypography.H4">Nuget stats could not be loaded.</BitText>
                            }
                        </BitPivotItem>
                        <BitPivotItem HeaderText="GitHub" @ref="gitHubPivotItem">
                            @if (isLoadingGitHub)
                            {
                                <BitStack HorizontalAlign="BitAlignment.Center">
                                    <BitRippleLoading />
                                </BitStack>
                            }
                            else if (gitHubStats is not null)
                            {
                                <BitStack>
                                    <BitStack Horizontal>
                                        <BitText>Name:</BitText>
                                        <BitText><b>@gitHubStats.Name</b></BitText>
                                    </BitStack>
                                    <BitStack Horizontal>
                                        <BitText>Total stars:</BitText>
                                        <BitText><b>@gitHubStats.StargazersCount.ToString("N0")</b></BitText>
                                    </BitStack>
                                    <BitStack Horizontal>
                                        <BitText>Forks count:</BitText>
                                        <BitText><b>@gitHubStats.ForksCount.ToString("N0")</b></BitText>
                                    </BitStack>
                                    <BitStack Horizontal>
                                        <BitText>Repo:</BitText>
                                        <BitLink Target="_blank"
                                                 Href="https://github.com/bitfoundation/bitfabric">
                                            <BitImage Alt="bit Fabric GitHub stars"
                                                      Src="https://img.shields.io/github/stars/bitfoundation/bitfabric?style=social&label=Github%20%E2%9C%A8" />
                                        </BitLink>
                                    </BitStack>
                                </BitStack>
                            }
                            else
                            {
                                <BitText Typography="BitTypography.H4">GitHub stats could not be loaded.</BitText>
                            }
                        </BitPivotItem>
                    </BitPivot>
                </BitStack>
            </BitCard>
        </CascadingValue>
        <br />
        @*#endif*@

        @* What made this app: bit Fabric and bit CLI, in every module. *@
        <BitCard FullWidth Style="padding:4rem">
            <BitStack HorizontalAlign="BitAlignment.Center">
                <BitText Typography="BitTypography.H5">bit Fabric</BitText>
                <BitText Typography="BitTypography.Body1" Align="BitTextAlign.Center">
                    @Localizer["This app was made with bit Fabric. Your AI agent builds on a foundation where everything already works, and the code is yours."]
                </BitText>
                <BitLink Href="https://bitfabric.co" Target="_blank" NoUnderline>
                    <BitStack Horizontal VerticalAlign="BitAlignment.Baseline" Gap="0.5rem">
                        @Localizer[nameof(AppStrings.LearnMore)]
                        <BitIcon Size="BitSize.Small" IconName="@(CurrentDir is BitDir.Rtl ? BitIconName.ChromeBack : BitIconName.ChromeBackMirrored)" />
                    </BitStack>
                </BitLink>
            </BitStack>
        </BitCard>

        <BitStack Horizontal Wrap WrapSm="false" Gap="2rem">
            <BitCard Style="padding:3rem" FullWidth>
                <BitStack HorizontalAlign="BitAlignment.Center">
                    <BitText Typography="BitTypography.H5">@Localizer["Start your own"]</BitText>
                    <BitText Typography="BitTypography.Body1" Align="BitTextAlign.Center">
                        @Localizer["Answer a few questions about your product, and bit Fabric sets up a project like this one for your AI agent."]
                    </BitText>
                    <BitButton Variant="BitVariant.Outline" Href="https://bitfabric.co/new" Target="_blank">
                        @Localizer["Create a project"]
                    </BitButton>
                </BitStack>
            </BitCard>

            <BitCard Style="padding:3rem" FullWidth>
                <BitStack HorizontalAlign="BitAlignment.Center">
                    <BitText Typography="BitTypography.H5">@Localizer["Works with your AI agent"]</BitText>
                    <BitText Typography="BitTypography.Body1" Align="BitTextAlign.Center">
                        @Localizer["Claude Code, GitHub Copilot, Codex, Cursor and others read the project's own instructions and skills."]
                    </BitText>
                    <BitLink Href="https://bitfabric.co/for" Target="_blank" NoUnderline>
                        <BitStack Horizontal VerticalAlign="BitAlignment.Baseline" Gap="0.5rem">
                            @Localizer[nameof(AppStrings.LearnMore)]
                            <BitIcon Size="BitSize.Small" IconName="@(CurrentDir is BitDir.Rtl ? BitIconName.ChromeBack : BitIconName.ChromeBackMirrored)" />
                        </BitStack>
                    </BitLink>
                </BitStack>
            </BitCard>

            <BitCard Style="padding:3rem" FullWidth>
                <BitStack HorizontalAlign="BitAlignment.Center">
                    <BitText Typography="BitTypography.H5">bit CLI</BitText>
                    <BitText Typography="BitTypography.Body1" Align="BitTextAlign.Center">
                        @Localizer["Creates the project, sets it up on any computer, makes its keys and keeps it up to date, from the command line."]
                    </BitText>
                    <BitLink Href="https://bitfabric.co/cli" Target="_blank" NoUnderline>
                        <BitStack Horizontal VerticalAlign="BitAlignment.Baseline" Gap="0.5rem">
                            @Localizer[nameof(AppStrings.LearnMore)]
                            <BitIcon Size="BitSize.Small" IconName="@(CurrentDir is BitDir.Rtl ? BitIconName.ChromeBack : BitIconName.ChromeBackMirrored)" />
                        </BitStack>
                    </BitLink>
                </BitStack>
            </BitCard>
        </BitStack>
    </BitStack>
</section>
