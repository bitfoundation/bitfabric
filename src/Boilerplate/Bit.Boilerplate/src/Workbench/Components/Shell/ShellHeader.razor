@inherits WorkbenchComponentBase

<BitMediaQuery ScreenQuery="BitScreenQuery.LtLg" OnChange="OnNarrowChanged" />

@* The one header of every section: the side panel's toggle, the logo, the section switcher and the open item, then the
   section's own buttons and the Workbench's. *@
<header class="shell-header @Class">
    @if (HasSidePanel)
    {
        <BitButton IconOnly Variant="BitVariant.Text" Size="BitSize.Small" Class="side-toggle"
                   IconName="@SideToggleIcon"
                   Title="@Localizer[WorkbenchSections.TextKeyOf(Section)]"
                   AriaLabel="@Localizer[WorkbenchSections.TextKeyOf(Section)]"
                   aria-expanded="@(IsSidePanelShown ? "true" : "false")"
                   aria-controls="wb-side-panel"
                   OnClick="ToggleSidePanel" />
    }

    <a class="brand" href="@(Section is WorkbenchSection.Home ? WorkbenchUrls.HomeTop : WorkbenchUrls.Home)" aria-label="@Localizer[nameof(WorkbenchStrings.WorkbenchTitle)]">
        <img src="_content/Boilerplate.Client.Core/images/bit-logo.svg" alt="" width="26" height="26" />
        <span>@Localizer[nameof(WorkbenchStrings.WorkbenchTitle)]</span>
    </a>

    <span class="crumb-separator" aria-hidden="true">/</span>
    <SectionMenu Section="Section" Waiting="reviewSession.NeedsYouCount" Class="section-menu" />

    @if (string.IsNullOrWhiteSpace(Title) is false)
    {
        <span class="crumb-separator crumb-item" aria-hidden="true">/</span>
        <BitText Typography="BitTypography.Body1" Class="crumb-title crumb-item" NoWrap Dir="BitDir.Auto" title="@Title">@Title</BitText>
    }

    @TitleExtra

    <BitSpacer />

    @Actions

    <LanguageMenu Size="BitSize.Small" />

    <SoundToggle Size="BitSize.Small" />

    <BitButton IconOnly Variant="BitVariant.Text" Size="BitSize.Small"
               IconName="@BitIconName.Contrast"
               Title="@Localizer[nameof(WorkbenchStrings.ToggleWorkbenchTheme)]"
               AriaLabel="@Localizer[nameof(WorkbenchStrings.ToggleWorkbenchTheme)]"
               OnClick="ToggleTheme" />

    @End
</header>
