@*+:cnd:noEmit*@
@* [mirror] what the app's layout puts around a page - keep in sync with: *@
@* - src/Client/Boilerplate.Client.Core/Components/Layout/MainLayout.razor *@
@inherits WorkbenchComponentBase

@if (ShowStatusBar && Scenario.DevicePreset.IsHandheld && Scenario.DevicePreset.GetSafeArea(Scenario.Rotated).Top > 0)
{
    <DeviceStatusBar Device="Scenario.DevicePreset" />
}

@if (Page.HasAppShell is false)
{
    <div class="wb-no-shell">
        <PreviewPageView Page="Page" />
    </div>
}
else if (Scenario.Chrome)
{
    <ChromeShell Page="Page">
        <PreviewPageView Page="Page" />
    </ChromeShell>

    @* The AI chat's floating button, as the app shows it over every page; it opens on the app's own chat. *@
    @*#if (signalR == true)*@
    <Boilerplate.Client.Core.Components.Layout.AppAiChatPanel />
    @*#endif*@
}
else
{
    <div class="bare-surface wb-no-shell">
        <PreviewPageView Page="Page" />
    </div>
}

@* The app's snack bars, which the page's messages show in. *@
<ChromeSnackBar />
