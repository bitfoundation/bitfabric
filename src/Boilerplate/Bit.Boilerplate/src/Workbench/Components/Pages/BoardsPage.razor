@page "/boards"
@page "/boards/{BoardId}"
@inherits WorkbenchComponentBase

<PageTitle>@(Board is { } titled ? $"{Localizer[titled.TitleKey]} · {Localizer[nameof(WorkbenchStrings.Boards)]}" : $"{Localizer[nameof(WorkbenchStrings.Boards)]} · {Localizer[nameof(WorkbenchStrings.WorkbenchTitle)]}")</PageTitle>

<WorkbenchFrame Section="WorkbenchSection.Boards" Title="@(Board is { } open ? Localizer[open.TitleKey].Value : null)" Class="boards-page">
    <SidePanel>
        <SectionSidebar AriaLabel="@Localizer[nameof(WorkbenchStrings.Boards)]"
                        SearchPlaceholder="@Localizer[nameof(WorkbenchStrings.SearchBoards)]"
                        Overview="Overview"
                        Groups="SideGroups"
                        CurrentKey="@Board?.Id"
                        SearchContent="SearchContent" />
    </SidePanel>
    <ChildContent>
        @if (BoardId is null)
        {
            <BoardsOverview />
        }
        else if (Board is { } board)
        {
            <DynamicComponent @key="board.Id" Type="board.ComponentType" />
        }
        else
        {
            <div class="missing">
                <BitIcon IconName="@BitIconName.Search" Size="BitSize.Large" />
                <p>@Localizer[nameof(WorkbenchStrings.BoardNotFound)]</p>
                <BitButton Variant="BitVariant.Outline" Href="@WorkbenchUrls.Boards">@Localizer[nameof(WorkbenchStrings.AllBoards)]</BitButton>
            </div>
        }
    </ChildContent>
</WorkbenchFrame>
