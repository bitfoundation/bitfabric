<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features Condition=" '$(framework)' != 'net10.0' ">$(Features);runtime-async=on</Features>
        <IsAspireSharedProject Condition=" '$(aspire)' == 'true' OR '$(aspire)' == '' ">true</IsAspireSharedProject>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.System" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
        <PackageReference Include="Microsoft.Extensions.Telemetry" />
        <PackageReference Condition="'$(redis)' == 'true' OR '$(redis)' == ''" Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
        <PackageReference Condition="'$(redis)' == 'true' OR '$(redis)' == ''" Include="Aspire.StackExchange.Redis" />
        <PackageReference Condition="'$(redis)' == 'true' OR '$(redis)' == ''" Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />
        <PackageReference Condition="'$(redis)' == 'true' OR '$(redis)' == ''" Include="ZiggyCreatures.FusionCache.Locking.Distributed.Redis" />
        <PackageReference Condition="('$(redis)' == 'true' OR '$(redis)' == '') AND ('$(signalR)' == 'true' OR '$(signalR)' == '')" Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
        <PackageReference Include="ZiggyCreatures.FusionCache.AspNetCore.OutputCaching" />
        <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Shared\Boilerplate.Shared.csproj" />
    </ItemGroup>

<!--/-:msbuild-conditional:noEmit -->
    <!-- The project's id in bit.json, which /healthz reports (See HealthReportDto.ProjectId). -->
    <PropertyGroup Condition="'$(BitProjectId)' == '' AND Exists('$(MSBuildThisFileDirectory)../../../bit.json')">
        <BitProjectId>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../../bit.json')), '"projectId"\s*:\s*"([^"]+)"').Groups[1].Value)</BitProjectId>
    </PropertyGroup>

    <ItemGroup Condition="'$(BitProjectId)' != ''">
        <AssemblyMetadata Include="BitProjectId" Value="$(BitProjectId)" />
    </ItemGroup>
<!--/+:msbuild-conditional:noEmit -->

</Project>