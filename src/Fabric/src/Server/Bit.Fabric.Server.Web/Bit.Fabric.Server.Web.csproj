<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <UserSecretsId>BF12BB12-683A-4D41-8F17-82E0B7A256D0</UserSecretsId>
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Environment)' != 'Development' And '$(SelfContained)' == 'true'">
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Bit.Fabric.Client.Core.Infrastructure.Services" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Bit.BlazorES2019" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bit.Fabric.Server.Shared\Bit.Fabric.Server.Shared.csproj" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Yarp.ReverseProxy" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
        <PackageReference Include="AspNetCore.HealthChecks.Uris" />
        <ProjectReference Include="..\..\Client\Bit.Fabric.Client.Web\Bit.Fabric.Client.Web.csproj" />
        <ProjectReference Include="..\..\Client\Bit.Fabric.Client.Core\Bit.Fabric.Client.Core.csproj" />
        <!-- By referencing Client.Core in Server.Web project, you can build the Client.Web project just once and then unload it during development with Blazor Server, which significantly speeds up build times. -->
    </ItemGroup>

    <ItemGroup>
        <!-- The one-line installers, served as text at /install.ps1 and /install.sh (InstallerEndpoints) -->
        <EmbeddedResource Include="Installers\install.ps1;Installers\install.sh" LogicalName="Installers/%(Filename)%(Extension)" />
        <!-- What /llms.txt and /.well-known/security.txt serve (WebApplicationExtensions.UseSiteMap) -->
        <EmbeddedResource Include="Seo\llms.txt;Seo\security.txt" LogicalName="Seo/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup Condition="'$(Environment)' != 'Development'">
        <Compile Remove="Infrastructure\Services\FileWatcherService.cs" />
    </ItemGroup>


    <!--
    https://learn.microsoft.com/en-us/dotnet/core/docker/publish-as-container
    https://learn.microsoft.com/en-us/visualstudio/containers/container-msbuild-properties
    -->
    <PropertyGroup>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <EnableSdkContainerDebugging Condition="'$(Environment)' == 'Development'">True</EnableSdkContainerDebugging>
    </PropertyGroup>

</Project>
