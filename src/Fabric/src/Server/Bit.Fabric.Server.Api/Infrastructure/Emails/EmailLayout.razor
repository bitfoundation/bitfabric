@*
    The frame of every email bit Fabric sends: the logo, one card with a heading, why the reader got it and a quiet footer.
    Tables and inline styles, 600px at most, so Gmail, Outlook and Apple Mail show it alike; a <style> block adds dark mode
    and the phone's padding where a client reads it. The preheader is the line an inbox shows next to the subject.
*@
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@EmailStyles.Direction">
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>@Title</title>
    <style>
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        img { border: 0; outline: none; text-decoration: none; }
        @@media (max-width: 620px) {
            .bf-pad { padding: 28px 22px !important; }
            .bf-code { font-size: 26px !important; letter-spacing: 4px !important; }
        }
        @@media (prefers-color-scheme: dark) {
            .bf-bg { background-color: #0F1216 !important; }
            .bf-card { background-color: #181C22 !important; border-color: #2A3038 !important; }
            .bf-text { color: #F1F3F5 !important; }
            .bf-body { color: #C9CED6 !important; }
            .bf-muted { color: #98A1AD !important; }
            .bf-code { background-color: #202733 !important; border-color: #33405A !important; color: #FFFFFF !important; }
            .bf-link { color: #6AA8FF !important; }
        }
    </style>
</head>
<body class="bf-bg" dir="@EmailStyles.Direction" style="margin:0; padding:0; width:100%; background-color:#F3F5F8;">
    <div style="display:none; max-height:0; max-width:0; overflow:hidden; opacity:0; mso-hide:all; font-size:1px; line-height:1px; color:#F3F5F8;">
        @Preheader @((MarkupString)PreheaderFiller)
    </div>
    <table role="presentation" class="bf-bg" width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color:#F3F5F8;">
        <tr>
            <td align="center" style="padding:32px 12px 40px;">
                @((MarkupString)"<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td><![endif]-->")
                <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width:600px;">
                    <tr>
                        <td style="padding:0 6px 20px; text-align:@EmailStyles.Start;">
                            @* "bit" is the logo and "Fabric" is text, so the name reads whole with images off too; always left to right. *@
                            <a href="@WebAppUrl.AbsoluteUri" dir="ltr" class="bf-text" style="text-decoration:none; color:#14171C; font-family:@EmailStyles.Font; font-size:21px; font-weight:700; line-height:24px;">
                                <img src="@LogoUrl" width="36" height="24" alt="bit" style="display:inline-block; vertical-align:middle; border:0;" />
                                <span style="vertical-align:middle;">Fabric</span>
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="bf-card bf-pad" style="background-color:#FFFFFF; border:1px solid #E2E6EB; border-radius:16px; padding:40px 40px 32px; text-align:@EmailStyles.Start; font-family:@EmailStyles.Font; color:#14171C;">
                            <h1 class="bf-text" style="margin:0 0 20px; font-size:24px; line-height:1.3; font-weight:700; color:#14171C;">@Heading</h1>
                            @ChildContent
                        </td>
                    </tr>
                    <tr>
                        <td class="bf-muted" style="padding:24px 16px 0; text-align:center; font-family:@EmailStyles.Font; font-size:13px; line-height:1.6; color:#5F6773;">
                            @if (string.IsNullOrWhiteSpace(Why) is false)
                            {
                                <p style="margin:0 0 14px;">@Why</p>
                            }
                            <p style="margin:0;">
                                <a href="@WebAppUrl.AbsoluteUri" class="bf-muted" style="color:#5F6773; text-decoration:underline;">@EmailLocalizer[nameof(EmailStrings.AppName)]</a><br />
                                @EmailLocalizer[nameof(EmailStrings.EmailFooterCompany)]
                            </p>
                        </td>
                    </tr>
                </table>
                @((MarkupString)"<!--[if mso]></td></tr></table><![endif]-->")
            </td>
        </tr>
    </table>
</body>
</html>
