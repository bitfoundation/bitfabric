@* A button the email clients draw alike, Outlook's included, and a plain link under it for those that don't. *@
<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin:4px 0 0;">
    <tr>
        <td align="center" bgcolor="@EmailStyles.Primary" style="border-radius:999px; background-color:@EmailStyles.Primary;">
            <a href="@Href.AbsoluteUri" target="_blank" style="display:inline-block; padding:13px 28px; font-family:@EmailStyles.Font; font-size:16px; font-weight:600; line-height:1.2; color:#FFFFFF; text-decoration:none; border-radius:999px;">@Text</a>
        </td>
    </tr>
</table>
@if (WithFallback)
{
    <p class="bf-muted" style="@EmailStyles.Small padding-top:12px;">
        @EmailLocalizer[nameof(EmailStrings.EmailButtonFallbackLead)]
        <a href="@Href.AbsoluteUri" target="_blank" class="bf-link" style="@EmailStyles.Link">@EmailLocalizer[nameof(EmailStrings.EmailButtonFallbackLink)]</a>
    </p>
}
