@* A code to type in, large and spaced so it reads and copies easily; digits stay left to right in Persian too. *@
<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin:4px 0 10px;">
    <tr>
        <td class="bf-code" dir="ltr" style="padding:14px 24px; background-color:#F1F5FC; border:1px solid #D5E1F5; border-radius:12px; font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:30px; font-weight:700; line-height:1.2; letter-spacing:6px; color:#0B1F3A;">@Code</td>
    </tr>
</table>
@if (ValidFor is { } validFor)
{
    <p class="bf-muted" style="@EmailStyles.Small padding-bottom:20px;">@ValidForText(validFor)</p>
}
