<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <UserSecretsId>BF12BB12-683A-4D41-8F17-82E0B7A256D0</UserSecretsId>
        <CoreCompileDependsOn>PrepareResources;$(CompileDependsOn)</CoreCompileDependsOn>
    </PropertyGroup>

    <PropertyGroup>
        <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../../openapi</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--file-name current --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
        <OpenApiGenerateDocumentsOnBuild Condition="'$(Environment)' != 'Development' OR '$(DotNetWatchBuild)' == 'true'">false</OpenApiGenerateDocumentsOnBuild>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Environment)' != 'Development' And '$(SelfContained)' == 'true'">
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    </PropertyGroup>

    <!-- The template version bit.json records, served as bit_template_version in the OAuth protected resource metadata (See OAuthProtectedResource). -->
    <PropertyGroup Condition="'$(BitTemplateVersion)' == '' AND Exists('$(MSBuildThisFileDirectory)../../../bit.json')">
        <BitTemplateVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../../bit.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</BitTemplateVersion>
    </PropertyGroup>

    <ItemGroup Condition="'$(BitTemplateVersion)' != ''">
        <AssemblyMetadata Include="BitTemplateVersion" Value="$(BitTemplateVersion)" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Text" />
        <Using Include="Microsoft.Extensions.Options" />
        <Using Include="Microsoft.AspNetCore.Authorization" />
        <Using Include="Microsoft.AspNetCore.Authentication" />
        <Using Include="Bit.Fabric.Server.Api.Infrastructure.Data" />
        <Using Include="Bit.Fabric.Server.Api.Infrastructure.Services" />
        <Using Include="Bit.Fabric.Server.Api.Infrastructure.HealthChecks" />
        <Using Include="Bit.Fabric.Server.Api.Infrastructure.Controllers" />
        <Using Include="Bit.Fabric.Server.Api.Infrastructure.RequestPipeline" />
        <Using Include="Bit.Fabric.Server.Api.Features.Identity.Models" />
        <Using Include="Bit.Fabric.Server.Api.Features.Identity.Services" />
        <Using Include="Bit.Fabric.Server.Api.Features.Identity.HealthChecks" />
        <Using Include="Bit.Fabric.Server.Api.Features.Identity.Resources" />
        <Using Include="Bit.Fabric.Server.Api.Features.Identity.Components" />
        <Using Include="Microsoft.EntityFrameworkCore.Migrations" />
        <Using Include="Microsoft.EntityFrameworkCore.Metadata.Builders" />
        <Using Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
        <Using Include="Hangfire" />
        <Using Include="Humanizer" />
        <Using Include="Asp.Versioning" />
        <Using Include="Riok.Mapperly.Abstractions" />
        <Using Include="Bit.Fabric.Shared.Infrastructure" />
        <Using Include="Bit.Fabric.Shared.Infrastructure.Attributes" />
        <Using Include="Bit.Fabric.Shared.Features.Identity" />
        <Using Include="Bit.Fabric.Shared.Features.Identity.Dtos" />
        <Using Include="Microsoft.AspNetCore.Identity" />
        <Using Include="Microsoft.EntityFrameworkCore" />
        <Using Include="Microsoft.AspNetCore.OData.Query" />
        <Using Include="Microsoft.AspNetCore.Mvc" />
        <Using Include="ZiggyCreatures.Caching.Fusion" />
        <Using Include="Microsoft.Extensions.AI" />
        <Using Include="Microsoft.AspNetCore.SignalR" />
        <Using Include="Bit.BlazorUI" />
        <Using Include="Bit.Fabric.Server.Api.Features.Chatbot" />
        <Using Include="Bit.Fabric.Server.Api.Infrastructure.SignalR" />
        <Using Include="Bit.Fabric.Server.Api.Infrastructure.DevMcp" />
        <Using Include="ModelContextProtocol.Server" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Mvc" />
        <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
        <PackageReference Include="Fido2.AspNet" />
        <PackageReference Include="Hangfire.AspNetCore" />
        <PackageReference Include="Hangfire.EntityFrameworkCore" />
        <PackageReference Include="HtmlSanitizer" />
        <PackageReference Include="libphonenumber-csharp" />
        <PackageReference Include="Humanizer" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
        <PackageReference Include="QRCoder" />
        <PackageReference Include="Bit.Bmage" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.HarfBuzz" />
        <!-- The server's image has no fontconfig, and the SLA report's PDF brings its own fonts. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
        <PackageReference Include="FluentEmail.Smtp" />
        <PackageReference Include="DnsClient" />
        <PackageReference Include="FluentStorage" />
        <PackageReference Include="AWSSDK.Core" />
        <PackageReference Include="FluentStorage.AWS" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.AspNetCore.OData" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Microsoft.Azure.SignalR" />
        <PackageReference Include="Bit.BlazorUI.AI.Server" />
        <PackageReference Include="Bit.BlazorUI.AI.ChatClient" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <PackageReference Include="System.Linq.Dynamic.Core" />
        <PackageReference Include="Bit.Belemetry.EntityFrameworkCore" />
        <PackageReference Include="Bit.Belemetry.Hangfire" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" PrivateAssets="all" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
        <PackageReference Include="AspNetCore.HealthChecks.Uris" />
        <PackageReference Include="AspNetCore.HealthChecks.Hangfire" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Identity.Web" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Twitter" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" />
        <PackageReference Include="AspNet.Security.OAuth.Apple" />
        <PackageReference Include="AspNet.Security.OAuth.GitHub" />
        <PackageReference Include="Riok.Mapperly" />
        <PackageReference Include="SmsBridge" />
        <PackageReference Include="AdsPush" />
        <PackageReference Include="Microsoft.Extensions.AI" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
        <PackageReference Include="Microsoft.SemanticKernel.Core" />
        <PackageReference Include="Microsoft.SemanticKernel.Connectors.HuggingFace" />
        <PackageReference Include="Microsoft.Agents.AI" />
        <PackageReference Include="Microsoft.Agents.AI.Hosting" />
        <PackageReference Include="Pgvector.EntityFrameworkCore" />
        <PackageReference Include="DistributedLock.Redis" />
        <PackageReference Include="Hangfire.Redis.StackExchange" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\..\Bit.ResxTranslator.json" Link="Features\Identity\Resources\Bit.ResxTranslator.json" />
        <ProjectReference Include="..\Bit.Fabric.Server.Shared\Bit.Fabric.Server.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Features\Identity\Resources\EmailStrings.resx">
            <Generator>MSBuild:Compile</Generator>
            <LastGenOutput>Features\Identity\Resources\EmailStrings.Designer.cs</LastGenOutput>
            <StronglyTypedFileName>$(IntermediateOutputPath)\EmailStrings.Designer.cs</StronglyTypedFileName>
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
            <StronglyTypedNamespace>Bit.Fabric.Server.Api.Features.Identity.Resources</StronglyTypedNamespace>
            <StronglyTypedClassName>EmailStrings</StronglyTypedClassName>
            <PublicClass>true</PublicClass>
        </EmbeddedResource>

        <!-- The SLA report's fonts, read by SlaPdfText: in the assembly, so a container needs no font files. -->
        <EmbeddedResource Include="Features\Monitoring\Fonts\*.ttf" LogicalName="SlaFonts.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Features\Monitoring\Fonts\*.otf" LogicalName="SlaFonts.%(Filename)%(Extension)" />

        <None Update="AppCertificate.*">
            <DependentUpon>AppCertificate.md</DependentUpon>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
    https://learn.microsoft.com/en-us/dotnet/core/docker/publish-as-container
    https://learn.microsoft.com/en-us/visualstudio/containers/container-msbuild-properties
    -->
    <PropertyGroup>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <EnableSdkContainerDebugging Condition="'$(Environment)' == 'Development'">True</EnableSdkContainerDebugging>
    </PropertyGroup>

</Project>
