<EmailLayout Title="@EmailLocalizer[nameof(EmailStrings.ResetPasswordCodeSubject), Model.Token]"
             Preheader="@EmailLocalizer[nameof(EmailStrings.ResetPasswordPreheader)]"
             Heading="@EmailLocalizer[nameof(EmailStrings.ResetPasswordHeading)]"
             WebAppUrl="@HttpContext.Request.GetWebAppUrl()"
             Why="@EmailLocalizer[nameof(EmailStrings.ResetPasswordWhy)]">
    <EmailGreeting Name="@Model.DisplayName" />
    <EmailParagraph>@EmailLocalizer[nameof(EmailStrings.ResetPasswordCodeIntro)]</EmailParagraph>
    <EmailCode Code="@Model.Token" ValidFor="@Model.ValidFor" />
    <EmailParagraph>@EmailLocalizer[nameof(EmailStrings.ResetPasswordButtonIntro)]</EmailParagraph>
    <EmailButton Href="@Model.Link" Text="@EmailLocalizer[nameof(EmailStrings.ResetPasswordButton)]" />
</EmailLayout>
