@inherits ComponentBase
@* Tiles of one fact each: an icon, a title, an amount when there is one, and a line, with a link or a command under it when the
   fact needs one. The home page's "where each piece lives", and the bands of /pricing and /trust. *@

<ul class="aht" style="--aht-min:@MinWidth">
    @foreach (var tile in Tiles)
    {
        <li @key="tile.Title" class="aht-tile">
            <BitIcon IconName="@tile.Icon" Variant="BitVariant.Fill" Circular="true" Class="aht-icon" />
            <div class="aht-words">
                <BitText Typography="BitTypography.H6" Element="@HeadingElement">@tile.Title</BitText>
                @if (tile.Value is not null)
                {
                    @* Isolated, so a right-to-left page keeps "$10" and "€4" the way they're written *@
                    <bdi class="aht-value">@tile.Value</bdi>
                }
                <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@tile.Text</BitText>
                @tile.More
            </div>
        </li>
    }
</ul>
