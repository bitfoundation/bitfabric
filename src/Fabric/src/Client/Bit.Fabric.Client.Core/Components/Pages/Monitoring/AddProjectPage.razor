@attribute [Route(PageUrls.AddProject)]
@attribute [Route("{culture?}" + PageUrls.AddProject)]
@attribute [Route(PageUrls.AddProjectCallback)]
@attribute [Route("{culture?}" + PageUrls.AddProjectCallback)]
@attribute [Authorize(Policy = AuthPolicies.TENANT_SELECTED)]
@inherits AppPageBase

<AppPageData Title="@(joining is null ? Localizer[nameof(AppStrings.MonitoringAddAProject)] : Localizer["Add an environment to {0}", joining.Name ?? ""])"
             PageTitle="@(joining is null ? Localizer[nameof(AppStrings.MonitoringAddAProject)] : Localizer["Add an environment to {0}", joining.Name ?? ""])" />

<div class="add-page">
    <div class="back">
        <BitButton Variant="BitVariant.Text" Size="BitSize.Small" IconName="@BackIcon" Href="@PageUrls.Projects">@Localizer[nameof(AppStrings.MonitoringProjects)]</BitButton>
    </div>

    @if (Connected is { } connectedId)
    {
        @* The approval came back: the first checks as they arrive, and what to do next. *@
        <ProjectConnected @key="connectedId" MonitoringId="connectedId" />
    }
    else if (IsCallback)
    {
        @* The customer's app sent the browser back with its answer. *@
        <section class="panel" aria-live="polite">
            @if (connectError is null)
            {
                <div class="waiting">
                    <BitRingLoading Size="BitSize.Small" />
                    <BitText Typography="BitTypography.Body1">@Localizer[nameof(AppStrings.MonitoringApprovedReadingHealthFirstTime)]</BitText>
                </div>
            }
            else
            {
                <BitMessage Color="BitColor.Error" Variant="BitVariant.Outline" AutoMultiline Title="@Localizer[nameof(AppStrings.MonitoringProjectWasNotAdded)]">
                    <ChildContent>@connectError</ChildContent>
                    <Actions>
                        <BitButton Size="BitSize.Small" Variant="BitVariant.Text" NoWrap Href="@PageUrls.AddProject">@Localizer[nameof(AppStrings.MonitoringAddItAgain)]</BitButton>
                    </Actions>
                </BitMessage>
            }
        </section>
    }
    else
    {
        <section class="panel" aria-labelledby="address-title">
            <BitText Typography="BitTypography.H6" Element="h2" Id="address-title">@Localizer[nameof(AppStrings.MonitoringYourAppAddress)]</BitText>
            <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer[nameof(AppStrings.MonitoringYourAppAddressHelp)]</BitText>

            <div class="address-form">
                <BitTextField @bind-Value="address" Immediate Placeholder="yourapp.com" InputMode="BitInputMode.Url" Class="address"
                              AutoCapitalize="none" AutoCorrect="false" SpellCheck="false" AriaLabel="@Localizer[nameof(AppStrings.MonitoringYourAppAddress)]"
                              OnEnter="WrapHandled(Find)" />
                <BitButton IconName="@BitIconName.Search" Loading="isProbing" Disabled="@string.IsNullOrWhiteSpace(address)" OnClick="WrapHandled(Find)">@Localizer[nameof(AppStrings.MonitoringFindMyApp)]</BitButton>
            </div>

            @if (probe is not null)
            {
                switch (probe.Outcome)
                {
                    case AddressProbeOutcome.Found:
                        <div class="result tone-ok">
                            <span class="mark" aria-hidden="true"><BitIcon IconName="@BitIconName.CompletedSolid" /></span>
                            <div class="result-text">
                                <BitText Typography="BitTypography.Subtitle1">@Localizer[nameof(AppStrings.MonitoringFoundApp), probe.AppTitle ?? Host(probe.Address)]</BitText>
                                @* The sentence's only number is the version, so all of it keeps Latin digits *@
                                <BitText Typography="BitTypography.Body2" Class="app-latin-digits">
                                    @(probe.TemplateVersion is { } version ? Localizer[nameof(AppStrings.MonitoringMadeWithBitFabricVersion), version] : Localizer[nameof(AppStrings.MonitoringMadeWithBitFabricUnknownVersion)])
                                    @if (probe.ServerAddress != probe.Address)
                                    {
                                        <span>@(" " + Localizer[nameof(AppStrings.MonitoringHealthReportIsOnItsServer)]) <span class="ltr app-latin-digits">@Host(probe.ServerAddress)</span>.</span>
                                    }
                                </BitText>
                                @if (probe.IsAlreadyAdded)
                                {
                                    <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary">@Localizer[nameof(AppStrings.MonitoringAlreadyWatched)]</BitText>
                                }
                                @if (joining is null)
                                {
                                    <BitTextField @bind-Value="name" Label="@Localizer[nameof(AppStrings.MonitoringProjectName)]" MaxLength="100" Class="name" Disabled="isWaitingForApproval" />
                                }
                                @* Production, Test, Staging or a name of the team's own; a project has one of each. *@
                                <BitTextField @bind-Value="environment" Label="@Localizer["Environment"]" MaxLength="50" Class="name" Disabled="isWaitingForApproval" />
                                <div class="environment-choices" role="group" aria-label="@Localizer["Environment"]">
                                    @foreach (var choice in environmentChoices)
                                    {
                                        <BitTag @key="choice" Size="BitSize.Small" Variant="BitVariant.Outline" Shape="BitShape.Pill" Color="BitColor.Primary" Text="@choice"
                                                Selected="@string.Equals(environment, choice, StringComparison.OrdinalIgnoreCase)" SelectedChanged="@(_ => environment = choice)" />
                                    }
                                </div>
                                @if (isWaitingForApproval)
                                {
                                    @* The approval runs beside this page; its answer comes back here (See Complete). *@
                                    <div class="waiting" aria-live="polite">
                                        <BitRingLoading Size="BitSize.Small" />
                                        <BitText Typography="BitTypography.Body2">@Localizer[nameof(AppStrings.MonitoringApproveInTheWindow)]</BitText>
                                    </div>
                                    <div class="actions">
                                        <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.OpenInNewWindow" Loading="isStarting" OnClick="WrapHandled(Connect)">@Localizer[nameof(AppStrings.MonitoringOpenItAgain)]</BitButton>
                                        <BitButton Variant="BitVariant.Text" OnClick="WrapHandled(CancelApproval)">@Localizer[nameof(AppStrings.Cancel)]</BitButton>
                                    </div>
                                }
                                else
                                {
                                    <BitButton IconName="@BitIconName.Signin" Loading="isStarting" OnClick="WrapHandled(Connect)" Class="inline-action">@Localizer[nameof(AppStrings.MonitoringContinueToApproval)]</BitButton>
                                    <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary">@Localizer[nameof(AppStrings.MonitoringApprovalHelp)]</BitText>
                                }
                                @if (connectError is not null)
                                {
                                    <BitMessage Color="BitColor.Error" Variant="BitVariant.Outline" AutoMultiline Title="@Localizer[nameof(AppStrings.MonitoringProjectWasNotAdded)]">@connectError</BitMessage>
                                }
                            </div>
                        </div>
                        break;

                    case AddressProbeOutcome.NotFound:
                        <div class="result tone-degraded">
                            <span class="mark" aria-hidden="true"><BitIcon IconName="@BitIconName.Unknown" /></span>
                            <div class="result-text">
                                <BitText Typography="BitTypography.Subtitle1">@Localizer[nameof(AppStrings.MonitoringNoAppAnswered)]</BitText>
                                <BitText Typography="BitTypography.Body2">
                                    @Localizer[nameof(AppStrings.MonitoringNotABitApp), Isolate(Host(probe.Address))]
                                </BitText>
                                <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary">@Localizer[nameof(AppStrings.MonitoringAnotherSiteOfYoursSuchAsAWordPress)]</BitText>
                                <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary">@Localizer[nameof(AppStrings.MonitoringOlderAppUpdate)]</BitText>
                                <div class="prompt">
                                    <span class="prompt-text">@UpgradePrompt</span>
                                    <BitButton Variant="BitVariant.Text" Size="BitSize.Small" IconName="@(copied == UpgradePrompt ? BitIconName.CheckMark : BitIconName.Copy)" OnClick="WrapHandled(() => Copy(UpgradePrompt))">@Localizer[nameof(AppStrings.Copy)]</BitButton>
                                </div>
                            </div>
                        </div>
                        break;

                    default:
                        <div class="result tone-down">
                            <span class="mark" aria-hidden="true"><BitIcon IconName="@BitIconName.StatusErrorFull" /></span>
                            <div class="result-text">
                                <BitText Typography="BitTypography.Subtitle1">@Localizer[nameof(AppStrings.MonitoringAddressDidNotAnswer), Host(probe.Address) is { Length: > 0 } host ? host : address ?? ""]</BitText>
                                <BitText Typography="BitTypography.Body2">@Localizer[nameof(AppStrings.MonitoringAddressDidNotAnswerHelp)]</BitText>
                            </div>
                        </div>
                        break;
                }
            }
        </section>

        @* From the approved design: what the approval gives bit Fabric, before anyone approves it (bitfabric-internal/specs/monitoring.md, Read health, nothing else). *@
        <section class="reads-panel" aria-labelledby="reads-title">
            <BitText Typography="BitTypography.Subtitle1" Element="h2" Id="reads-title">@Localizer[nameof(AppStrings.MonitoringWhatBitFabricReads)]</BitText>
            <ul class="reads">
                <li class="yes"><BitIcon IconName="@BitIconName.CheckMark" Size="BitSize.Small" Class="mark" />@Localizer[nameof(AppStrings.MonitoringReadsWhetherEachPartWorks)]</li>
                <li class="yes"><BitIcon IconName="@BitIconName.CheckMark" Size="BitSize.Small" Class="mark" />@Localizer[nameof(AppStrings.MonitoringReadsHowLongEachPartTakes)]</li>
                <li class="no"><BitIcon IconName="@BitIconName.Cancel" Size="BitSize.Small" Class="mark" />@Localizer[nameof(AppStrings.MonitoringReadsNeverYourData)]</li>
                <li class="no"><BitIcon IconName="@BitIconName.Cancel" Size="BitSize.Small" Class="mark" />@Localizer[nameof(AppStrings.MonitoringReadsNeverErrorDetails)]</li>
            </ul>
            <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary">@Localizer[nameof(AppStrings.MonitoringReadsDisconnectAnyTime)]</BitText>
        </section>
    }
</div>
