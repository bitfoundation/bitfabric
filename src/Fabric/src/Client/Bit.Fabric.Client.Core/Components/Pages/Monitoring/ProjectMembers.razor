@inherits AppComponentBase

@* Who works on the project (bitfabric-internal/specs/monitoring.md, Members are who works on it): every member of the team
   still sees it. *@
<section class="panel" aria-labelledby="members-title">
    <BitText Typography="BitTypography.Subtitle1" Element="h3" Id="members-title">@Localizer["Its people"]</BitText>
    <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary">@Localizer["Who works on this project. The whole team still sees it; taking someone off ends their alerts here."]</BitText>

    @if (people is null)
    {
        <BitShimmer Height="4rem" Radius="0.5rem" Label="@Localizer["Loading its people"]" />
    }
    else
    {
        <ul class="people">
            @foreach (var person in people)
            {
                <li @key="person.UserId" class="@(person.IsMember ? "person" : "person not-member")">
                    <BitPersona PrimaryText="@person.Name" Size="BitPersonaSize.Size32"
                                SecondaryText="@(person.IsMember ? (person.AlertRouteCount > 0 ? Localizer["Gets its alerts"] : Localizer["Works on it"]) : Localizer["In the team"])" />
                    @if (person.IsMember)
                    {
                        <BitButton Variant="BitVariant.Text" Size="BitSize.Small" Color="BitColor.Error" IconName="@BitIconName.PeopleBlock"
                                   Loading="@(busy == person.UserId)" OnClick="WrapHandled(() => Remove(person))"
                                   AriaDescription="@person.Name">@Localizer["Take off"]</BitButton>
                    }
                    else
                    {
                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IconName="@BitIconName.AddFriend"
                                   Loading="@(busy == person.UserId)" OnClick="WrapHandled(() => Add(person))"
                                   AriaDescription="@person.Name">@Localizer["Add"]</BitButton>
                    }
                </li>
            }
        </ul>
    }
</section>
