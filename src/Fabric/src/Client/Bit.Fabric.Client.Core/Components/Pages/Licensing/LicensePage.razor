@attribute [Route(PageUrls.License)]
@attribute [Route("{culture?}" + PageUrls.License)]
@inherits AppPageBase

@* Not [Authorize], which lands on NotAuthorizedPage: the link bit CLI prints arrives signed out, so this page goes to
   /sign-in with itself as the return url, query string and all. *@

<AppPageData Title="@Localizer[nameof(AppStrings.LicensePageTitle)]" />

<section class="license-page">
    @if (isLoading || redirectToSignIn)
    {
        <BitProgress Indeterminate Label="@Localizer[nameof(AppStrings.LicenseCheckingSignIn)]" />
    }
    else if (missing is not null)
    {
        <BitMessage Color="BitColor.Warning" Variant="BitVariant.Outline" Tinted Multiline>@missing</BitMessage>
    }
    else if (issued is null)
    {
        <div class="license-intro">
            <BitText Typography="BitTypography.H4" Element="h1" Class="license-title">@Localizer[nameof(AppStrings.LicenseFreeFor), ProjectName!]</BitText>
            <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">
                @Localizer[nameof(AppStrings.LicenseWhatAProjectIs)]
            </BitText>
        </div>

        <dl class="license-facts">
            <dt>@Localizer[nameof(AppStrings.MonitoringProject)]</dt>
            <dd>@ProjectName</dd>
            <dt>@Localizer[nameof(AppStrings.LicenseProjectId)]</dt>
            <dd class="license-mono">@Id</dd>
            <dt>@Localizer[nameof(AppStrings.LicenseFirstCommit)]</dt>
            <dd class="license-mono">@Commit</dd>
        </dl>

        @* A license belongs to a team (bitfabric-internal/specs/product.md, A License belongs to a Team). *@
        <div class="license-step" role="group" aria-labelledby="team-title">
            <BitText Typography="BitTypography.Subtitle1" Element="h2" Id="team-title">@Localizer[nameof(AppStrings.LicenseTeamThatHoldsIt)]</BitText>
            @if (teams.Count is 0)
            {
                <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer[nameof(AppStrings.LicenseNameYourTeam)]</BitText>
                <div class="team-form">
                    <BitTextField Value="@teamTitle" ValueChanged="@((string? title) => TitleChanged(title))" Immediate
                                  Label="@Localizer[nameof(AppStrings.MonitoringTeamName)]" Placeholder="@Localizer[nameof(AppStrings.LicenseTeamNameExample)]" MaxLength="64" Class="team-field" />
                    <BitTextField @bind-Value="teamName" Immediate Label="@Localizer[nameof(AppStrings.LicenseTeamShortName)]" Description="@Localizer[nameof(AppStrings.LicenseTeamShortNameHelp)]"
                                  MaxLength="63" Class="team-field" Styles="@(new() { Input = "direction: ltr" })" />
                </div>
            }
            else if (teams.Count is 1)
            {
                <div class="team-one">
                    <BitIcon IconName="@BitIconName.People" Color="BitColor.Primary" />
                    <BitText Typography="BitTypography.Body1" Weight="BitFontWeight.Semibold">@teams[0].Title</BitText>
                </div>
            }
            else
            {
                <BitDropdown TItem="BitDropdownItem<string>" TValue="string" Items="TeamItems" @bind-Value="selectedTeamId"
                             Label="@Localizer[nameof(AppStrings.Tenant)]" AriaLabel="@Localizer[nameof(AppStrings.LicenseTeamThatHoldsIt)]" Responsive Class="team-picker" />
            }
        </div>

        @if (error is not null)
        {
            <BitMessage Color="BitColor.Error" Variant="BitVariant.Outline" Tinted Multiline>@error</BitMessage>
        }

        <div>
            <BitButton IconName="@BitIconName.Certificate" Loading="isIssuing" Disabled="@(CanIssue is false)" OnClick="WrapHandled(Issue)">
                @(teams.Count is 0 ? Localizer[nameof(AppStrings.LicenseCreateTeamAndGetLicense)] : Localizer[nameof(AppStrings.LicenseGetTheFreeLicense)])
            </BitButton>
        </div>

        <PrivacyLine />
    }
    else
    {
        <div class="license-intro">
            <BitText Typography="BitTypography.H4" Element="h1" Class="license-title">@Localizer[nameof(AppStrings.LicenseHasItsLicense), issued.ProjectName!]</BitText>
            <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">
                @Localizer[nameof(AppStrings.LicenseFreeForUntil), issued.Holder!, issued.ExpiresOn.ToString("D", CultureInfo.CurrentUICulture)]
            </BitText>
        </div>

        @if (string.IsNullOrEmpty(Code) is false)
        {
            <BitMessage Color="BitColor.Success" Variant="BitVariant.Outline" Tinted Multiline>
                @Localizer[nameof(AppStrings.LicenseBitPicksItUp)]
            </BitMessage>
        }

        @* The prompt first, for the customer's own AI; the command second; never the bare license alone (the founder's call, 2026-11-26). *@
        <div class="license-step">
            <BitText Typography="BitTypography.Subtitle1" Element="h2">@Localizer[nameof(AppStrings.LicensePasteIntoYourAi)]</BitText>
            <div class="license-box">
                <code class="license-text" dir="ltr">@Prompt</code>
                <BitButton Size="BitSize.Small" IconName="@(copied == Prompt ? BitIconName.CheckMark : BitIconName.Copy)" OnClick="WrapHandled(() => Copy(Prompt))" Class="license-copy">
                    @(copied == Prompt ? Localizer[nameof(AppStrings.Copied)] : Localizer[nameof(AppStrings.Copy)])
                </BitButton>
            </div>
            <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer[nameof(AppStrings.LicenseSavedInBitJson)]</BitText>
        </div>

        <div class="license-step">
            <BitText Typography="BitTypography.Subtitle1" Element="h2">@Localizer[nameof(AppStrings.LicenseOrRunThis)]</BitText>
            <div class="license-box">
                <code class="license-text" dir="ltr">@Command</code>
                <BitButton Size="BitSize.Small" Variant="BitVariant.Outline" IconName="@(copied == Command ? BitIconName.CheckMark : BitIconName.Copy)" OnClick="WrapHandled(() => Copy(Command))" Class="license-copy">
                    @(copied == Command ? Localizer[nameof(AppStrings.Copied)] : Localizer[nameof(AppStrings.Copy)])
                </BitButton>
            </div>
        </div>

        <div>
            <BitButton Variant="BitVariant.Text" IconName="@BitIconName.Certificate" Href="@PageUrls.Licenses">@Localizer[nameof(AppStrings.LicenseSeeYourTeamsLicenses)]</BitButton>
        </div>

        <PrivacyLine />
    }
</section>
