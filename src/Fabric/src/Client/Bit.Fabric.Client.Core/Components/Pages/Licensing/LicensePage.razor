@attribute [Route(PageUrls.License)]
@attribute [Route("{culture?}" + PageUrls.License)]
@inherits AppPageBase

@* Not [Authorize], which lands on NotAuthorizedPage: the link bit CLI prints arrives signed out, so this page goes to
   /sign-in with itself as the return url, query string and all. *@

<AppPageData Title="@Localizer["Your project's license"]" />

<section class="license-page">
    @if (isLoading || redirectToSignIn)
    {
        <BitProgress Indeterminate Label="@Localizer["Checking your sign-in"]" />
    }
    else if (missing is not null)
    {
        <BitMessage Color="BitColor.Warning" Variant="BitVariant.Outline" Tinted Multiline>@missing</BitMessage>
    }
    else if (issued is null)
    {
        <div class="license-intro">
            <BitText Typography="BitTypography.H4" Element="h1" Class="license-title">@Localizer["A free license for {0}", ProjectName!]</BitText>
            <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">
                @Localizer["A project is one system with its own data: a till and its back office on one server are one project."]
            </BitText>
        </div>

        <dl class="license-facts">
            <dt>@Localizer["Project"]</dt>
            <dd>@ProjectName</dd>
            <dt>@Localizer["Project id"]</dt>
            <dd class="license-mono">@Id</dd>
            <dt>@Localizer["First commit"]</dt>
            <dd class="license-mono">@Commit</dd>
        </dl>

        @* A license belongs to a team (bitfabric-internal/specs/product.md, A License belongs to a Team). *@
        <div class="license-step" role="group" aria-labelledby="team-title">
            <BitText Typography="BitTypography.Subtitle1" Element="h2" Id="team-title">@Localizer["The team that holds it"]</BitText>
            @if (teams.Count is 0)
            {
                <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer["A license belongs to a team. Name yours; you can invite the others later."]</BitText>
                <div class="team-form">
                    <BitTextField Value="@teamTitle" ValueChanged="@((string? title) => TitleChanged(title))" Immediate
                                  Label="@Localizer["Team name"]" Placeholder="@Localizer["Such as Contoso"]" MaxLength="64" Class="team-field" />
                    <BitTextField @bind-Value="teamName" Immediate Label="@Localizer["Short name"]" Description="@Localizer["Lowercase letters, digits and dashes."]"
                                  MaxLength="63" Class="team-field" Styles="@(new() { Input = "direction: ltr" })" />
                </div>
            }
            else if (teams.Count is 1)
            {
                <div class="team-one">
                    <BitIcon IconName="@BitIconName.People" Color="BitColor.Primary" />
                    <BitText Typography="BitTypography.Body1" Weight="BitFontWeight.Semibold">@teams[0].Title</BitText>
                </div>
            }
            else
            {
                <BitDropdown TItem="BitDropdownItem<string>" TValue="string" Items="TeamItems" @bind-Value="selectedTeamId"
                             Label="@Localizer["Team"]" AriaLabel="@Localizer["The team that holds it"]" Responsive Class="team-picker" />
            }
        </div>

        @if (error is not null)
        {
            <BitMessage Color="BitColor.Error" Variant="BitVariant.Outline" Tinted Multiline>@error</BitMessage>
        }

        <div>
            <BitButton IconName="@BitIconName.Certificate" Loading="isIssuing" Disabled="@(CanIssue is false)" OnClick="WrapHandled(Issue)">
                @(teams.Count is 0 ? Localizer["Create the team and get the license"] : Localizer["Get the free license"])
            </BitButton>
        </div>

        <PrivacyLine />
    }
    else
    {
        <div class="license-intro">
            <BitText Typography="BitTypography.H4" Element="h1" Class="license-title">@Localizer["{0} has its license", issued.ProjectName!]</BitText>
            <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">
                @Localizer["Free, for {0}, until {1}.", issued.Holder!, issued.ExpiresOn.ToString("D", CultureInfo.CurrentUICulture)]
            </BitText>
        </div>

        @if (string.IsNullOrEmpty(Code) is false)
        {
            <BitMessage Color="BitColor.Success" Variant="BitVariant.Outline" Tinted Multiline>
                @Localizer["If bit is waiting in your terminal, it picks the license up by itself and carries on."]
            </BitMessage>
        }

        @* The prompt first, for the customer's own AI; the command second; never the bare license alone (the founder's call, 2026-11-26). *@
        <div class="license-step">
            <BitText Typography="BitTypography.Subtitle1" Element="h2">@Localizer["Paste this into your AI"]</BitText>
            <div class="license-box">
                <code class="license-text" dir="ltr">@Prompt</code>
                <BitButton Size="BitSize.Small" IconName="@(copied == Prompt ? BitIconName.CheckMark : BitIconName.Copy)" OnClick="WrapHandled(() => Copy(Prompt))" Class="license-copy">
                    @(copied == Prompt ? Localizer["Copied"] : Localizer["Copy"])
                </BitButton>
            </div>
            <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer["It saves the license in the project's bit.json, which bit checks without asking anyone."]</BitText>
        </div>

        <div class="license-step">
            <BitText Typography="BitTypography.Subtitle1" Element="h2">@Localizer["Or run this in the project's folder"]</BitText>
            <div class="license-box">
                <code class="license-text" dir="ltr">@Command</code>
                <BitButton Size="BitSize.Small" Variant="BitVariant.Outline" IconName="@(copied == Command ? BitIconName.CheckMark : BitIconName.Copy)" OnClick="WrapHandled(() => Copy(Command))" Class="license-copy">
                    @(copied == Command ? Localizer["Copied"] : Localizer["Copy"])
                </BitButton>
            </div>
        </div>

        <div>
            <BitButton Variant="BitVariant.Text" IconName="@BitIconName.Certificate" Href="@PageUrls.Licenses">@Localizer["See your teams' licenses"]</BitButton>
        </div>

        <PrivacyLine />
    }
</section>
