@attribute [Route(PageUrls.Licenses)]
@attribute [Route("{culture?}" + PageUrls.Licenses)]
@attribute [Authorize]
@inherits AppPageBase

<AppPageData Title="@Localizer["Licenses"]" PageTitle="@Localizer["Your teams' licenses"]" />

<section class="licenses-page">
    <div class="back">
        <BitButton Variant="BitVariant.Text" Size="BitSize.Small" IconName="@BackIcon" Href="@PageUrls.Projects">@Localizer[nameof(AppStrings.MonitoringProjects)]</BitButton>
    </div>

    <header class="head">
        <BitText Typography="BitTypography.H5" Element="h1">@Localizer["Your teams' licenses"]</BitText>
        <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer["Every license your teams hold, newest first. bit keeps each in its project's bit.json."]</BitText>
    </header>

    @if (isLoading)
    {
        <div class="list" aria-busy="true">
            @for (var i = 0; i < 3; i++)
            {
                <BitShimmer Height="6rem" Radius="0.75rem" Label="@(i is 0 ? Localizer["Loading your licenses"] : null)" />
            }
        </div>
    }
    else if (licenses.Count is 0)
    {
        <section class="empty" aria-labelledby="empty-title">
            <span class="empty-mark" aria-hidden="true"><BitIcon IconName="@BitIconName.Certificate" Size="BitSize.Large" /></span>
            <BitText Typography="BitTypography.H6" Element="h2" Id="empty-title">@Localizer["No license yet"]</BitText>
            <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer["Run bit license in a project's folder for the link that gets it one, free."]</BitText>
        </section>
    }
    else
    {
        @foreach (var team in licenses.GroupBy(license => license.TeamId))
        {
            <section class="team" aria-labelledby="@($"team-{team.Key:N}")">
                <BitText Typography="BitTypography.Subtitle1" Element="h2" Id="@($"team-{team.Key:N}")" Class="team-title">
                    <BitIcon IconName="@BitIconName.People" Size="BitSize.Small" Color="BitColor.SecondaryForeground" />
                    @team.First().TeamTitle
                </BitText>
                <ul class="list">
                    @foreach (var license in team)
                    {
                        <li @key="license.Id" class="license">
                            <div class="license-head">
                                <BitText Typography="BitTypography.Subtitle2" Element="span" Class="license-project">@license.ProjectName</BitText>
                                <ProjectLicenseTag License="@AsProjectLicense(license)" />
                            </div>
                            <dl class="facts">
                                <div><dt>@Localizer["Issued"]</dt><dd>@Day(license.IssuedOn)</dd></div>
                                <div><dt>@Localizer["Until"]</dt><dd>@Day(license.ExpiresOn)</dd></div>
                                @if (license.IssuedBy is { } by)
                                {
                                    <div><dt>@Localizer["Got by"]</dt><dd>@by</dd></div>
                                }
                                <div><dt>@Localizer["First commit"]</dt><dd class="mono" dir="ltr">@license.FirstCommit?[..Math.Min(12, license.FirstCommit.Length)]</dd></div>
                            </dl>
                            <div class="actions">
                                <BitButton Size="BitSize.Small" Variant="BitVariant.Outline" IconName="@(copied == license.Id ? BitIconName.CheckMark : BitIconName.Copy)"
                                           OnClick="WrapHandled(() => CopyPrompt(license))">
                                    @(copied == license.Id ? Localizer["Copied"] : Localizer["Copy the prompt for your AI"])
                                </BitButton>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }
    }

    <PrivacyLine />
</section>
