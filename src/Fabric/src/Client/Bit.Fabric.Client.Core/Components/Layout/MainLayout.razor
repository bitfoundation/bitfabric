@* [mirror] what the app's layout puts around a page - keep in sync with: *@
@* - src/Workbench/Components/Preview/PreviewSurface.razor (the app's shell is ChromeShell's, see AppShell.razor) *@
@inherits LayoutComponentBase

<CascadingValue Value="currentTenant">
    <CascadingValue Value="currentDir">
        <CascadingValue Value="currentUser">
            <CascadingValue Value="currentTheme">
                <CascadingValue Value="currentRouteData">
                    <CascadingValue Name="@Parameters.IsOnline" Value="IsOnline">

                        <AppHeadCoordinator />

                        @* Only @Body goes inside: AppShell skips the renders whose parameters didn't change (See AppShell.GetParametersRenderKey). *@
                        <AppShell NavPanelItems="navPanelItems" IsIdentityPage="isIdentityPage">
                            @Body
                        </AppShell>

                        <ForceUpdateSnackBar />
                        <StatusPageNotice />
                        <AppSnackBar />
                        <AppDevTools />
                        <JobProgress />
                        <BitModalContainer ModalParameters="ModalParameters" />
                        <AppJsBridge />
                        <AppFileSaveAnchor />
                        <AppConsentBanner />

                        <AppAiChatPanel />

                        <AppOnboardingHost />

                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
</CascadingValue>
