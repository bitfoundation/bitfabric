@* Kept out of Routes.razor's LayoutView, so this component has no parameters and a re-render of MainLayout or AppShell doesn't re-render the router and all of its routes. *@
<AppRouter AppAssembly="@GetType().Assembly"
           AdditionalAssemblies="@(AssemblyLoadContext.Default.Assemblies.Where(asm => asm.GetName().Name?.Contains("Bit.Fabric.Client") is true))">
    <Routes>
    </Routes>
    <Found Context="routeData">
        <AppRouteDataPublisher RouteData="@routeData" />
        <AuthorizeRouteView RouteData="@routeData">
            <Authorizing>
                <LoadingComponent />
            </Authorizing>
            <NotAuthorized>
                <NotAuthorizedPage PageType="@routeData.PageType" />
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <AppRouteDataPublisher RouteData="@null" />
        <NotFoundPage />
    </NotFound>
    <Navigating>
        <LoadingComponent />
    </Navigating>
</AppRouter>
