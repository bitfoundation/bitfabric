<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
        <Content Remove="appsettings*.json" />
        <EmbeddedResource Include="appsettings*.json" />

        <PackageReference Include="Bit.Butil" />
        <PackageReference Include="Bit.BlazorUI" />
        <PackageReference Include="Bit.BlazorUI.Icons" />
        <PackageReference Include="Bit.BlazorUI.Assets" />
        <Using Include="Bit.Brouter" />
        <Using Include="Microsoft.AspNetCore.SignalR.Client" />
        <PackageReference Include="Bit.Brouter" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
        <PackageReference Include="Bit.BlazorUI.AI" />
        <PackageReference Include="Bit.BlazorUI.AI.SignalR" />
        <PackageReference Include="Bit.BlazorUI.Extras" />
        <PackageReference Include="Bit.Bmage.Blazor" />
        <PackageReference Include="Bit.BevTools" />
        <PackageReference Include="Bit.BevTools.Loader" />
        <PackageReference Include="Bit.BevTools.Belemetry" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
        <PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />

        <Using Include="System.Reflection" />
        <Using Include="System.Net.Http.Json" />
        <Using Include="System.Collections.Concurrent" />
        <Using Include="System.Runtime.CompilerServices" />
        <Using Include="Microsoft.JSInterop" />
        <Using Include="Microsoft.Extensions.Logging" />
        <Using Include="Microsoft.AspNetCore.Components" />
        <Using Include="Microsoft.AspNetCore.Authorization" />
        <Using Include="Microsoft.AspNetCore.Components.Routing" />
        <Using Include="Microsoft.AspNetCore.Components.Authorization" />
        <Using Include="Bit.Butil" />
        <Using Include="Bit.BlazorUI" />
        <Using Include="Bit.Fabric.Shared" />
        <Using Include="Bit.Fabric.Shared.Features.Identity" />
        <Using Include="Bit.Fabric.Shared.Features.Identity.Dtos" />
        <Using Include="Bit.Fabric.Client.Core.Components.Layout" />
        <Using Include="Bit.Fabric.Client.Core.Components.Common" />
        <Using Include="Bit.Fabric.Client.Core.Infrastructure.Services" />
        <Using Include="Bit.Fabric.Client.Core.Infrastructure.Services.Contracts" />
        <Using Include="Bit.Fabric.Client.Core.Infrastructure.Services.HttpMessageHandlers" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Shared\Bit.Fabric.Shared.csproj" />
        <!-- The home page's films, which Client.Web loads lazily: nothing may name one of its types before LazyAssemblyLoader has loaded it -->
        <ProjectReference Include="..\Bit.Fabric.Client.Films\Bit.Fabric.Client.Films.csproj" />
        <ProjectReference Include="..\Bit.Fabric.Client.Diagrams\Bit.Fabric.Client.Diagrams.csproj" />
    </ItemGroup>

    <ItemGroup>
        <TypeScriptFiles Include="**\*.ts" Exclude="node_modules\**\*.ts" />
    </ItemGroup>

    <Target Name="BeforeBuildTasks" BeforeTargets="ResolveProjectStaticWebAssets;ResolveScopedCssInputs" Condition=" '$(DesignTimeBuild)' != 'true' ">
        <CallTarget Targets="InstallNodejsDependencies" />
        <CallTarget Targets="BuildJavaScript" />
        <CallTarget Targets="BuildCssFiles" />
        <ItemGroup>
            <Content Include="**\*.razor.css;wwwroot\scripts\app.js;wwwroot\styles\app.css" Exclude="@(Content);@(None);node_modules\**;bin\**;obj\**" />
        </ItemGroup>
    </Target>

    <Target Name="InstallNodejsDependencies" Inputs="package.json;package-lock.json" Outputs="node_modules\.package-lock.json">
        <Exec Command="npm install" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <Target Name="BuildJavaScript" Inputs="@(TypeScriptFiles);tsconfig.json;package.json;package-lock.json" Outputs="wwwroot\scripts\app.js">
        <Exec Command="node_modules/.bin/tsc" StandardOutputImportance="high" StandardErrorImportance="high" />
        <Exec Command="node_modules/.bin/esbuild Scripts/index.ts --bundle --target=safari15,firefox100,chrome95 --outfile=wwwroot/scripts/app.js --minify --sourcemap" StandardOutputImportance="high" StandardErrorImportance="high" />
    </Target>

    <Target Name="BuildCssFiles">
        <Exec Command="node_modules/.bin/sass Components:Components Styles/app.scss:wwwroot/styles/app.css --style compressed --silence-deprecation=import --update --color" StandardOutputImportance="high" StandardErrorImportance="high" LogStandardErrorAsError="true" />
    </Target>

    <ItemGroup>
        <Content Remove="package*.json" />
        <Content Remove="tsconfig.json" />
        <Content Remove="wwwroot\fonts\**\README.md" />
        <None Include="package*json" />
        <None Include="tsconfig.json" />
        <None Include="wwwroot\fonts\**\README.md" />
    </ItemGroup>

</Project>
