@* [mirror] each app's About page - keep in sync with:
   - src/Client/Bit.Fabric.Client.Web/Components/Pages/AboutPage.razor
   - src/Client/Bit.Fabric.Client.Maui/Components/Pages/AboutPage.razor *@
@attribute [Route(PageUrls.About)]
@attribute [Route("{culture?}" + PageUrls.About)]
@inherits AppPageBase
@using Bit.Fabric.Client.Core.Components.Pages.Home

@* bit Fabric's About page is Client.Core's (bitfabric-internal/specs/home-page.md, 2026-11-19); its last section is what
   this app tells of itself, the signature of the build it runs among it. *@
<AboutBitFabric>
    <AppInfoCard AppName="@AboutBitFabric.AppName"
                 AppVersion="@appVersion"
                 Platform="@platform"
                 Environment="@AppEnvironment.Current"
                 ProcessId="@processId"
                 WebView="@webView"
                 Signer="@signer" />
</AboutBitFabric>
