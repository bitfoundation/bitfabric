@* A made-up person's face, drawn: each one's hair and colors are their own, so the films show who is on a screen *@
<svg class="ah-face is-@Person.ToString().ToLowerInvariant()" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <circle class="ah-face-back" cx="20" cy="20" r="20" />
    @if (Person is AppHomePerson.Sara)
    {
        <path class="ah-face-hair" d="M10.6 19 C10.2 9.6 14.6 6.4 20 6.4 C25.4 6.4 29.8 9.6 29.4 19 L29.6 28.5 C27.4 29.6 24.6 29.4 23 28 L17 28 C15.4 29.4 12.6 29.6 10.4 28.5 Z" />
    }
    <path class="ah-face-body" d="M5.5 40 C5.5 31 11.5 27.4 20 27.4 C28.5 27.4 34.5 31 34.5 40 Z" />
    <rect class="ah-face-skin" x="17.2" y="22" width="5.6" height="6" rx="2" />
    <circle class="ah-face-skin" cx="20" cy="17.6" r="7.6" />
    @switch (Person)
    {
        case AppHomePerson.Sara:
            <path class="ah-face-hair" d="M12.3 17 C12.2 11.2 15.6 9 20 9 C24.4 9 27.8 11.2 27.7 17 C25.6 14 22.4 12.6 18.6 13 C16 13.3 13.8 14.6 12.3 17 Z" />
            break;
        case AppHomePerson.Emma:
            <circle class="ah-face-hair" cx="20" cy="7.6" r="3.4" />
            <path class="ah-face-hair" d="M12.4 16.8 C12.2 11.4 15.6 9.6 20 9.6 C24.4 9.6 27.8 11.4 27.6 16.8 C26 14 23.2 12.8 20 12.8 C16.8 12.8 14 14 12.4 16.8 Z" />
            break;
        case AppHomePerson.Lucas:
            <path class="ah-face-hair" d="M12.4 17 C11.8 11 15.4 9.2 20.2 9.2 C25 9.2 28.4 11.2 27.6 17 C26.8 14.6 25.2 13.8 23.6 13.4 C21 12.8 17.2 13 15.2 14 C13.8 14.7 12.9 15.7 12.4 17 Z" />
            break;
        default:
            <path class="ah-face-hair" d="M12.5 16.4 C12.2 11.2 15.6 9.8 20 9.8 C24.4 9.8 27.8 11.2 27.5 16.4 C24.4 14.8 21.4 14.4 20 14.4 C18.6 14.4 15.6 14.8 12.5 16.4 Z" />
            <path class="ah-face-hair" d="M12.6 18.6 C13 24.6 16.6 25.8 20 25.8 C23.4 25.8 27 24.6 27.4 18.6 C26.4 22 23.6 23 20 23 C16.4 23 13.6 22 12.6 18.6 Z" />
            break;
    }
    <circle class="ah-face-eye" cx="17.2" cy="18" r=".95" />
    <circle class="ah-face-eye" cx="22.8" cy="18" r=".95" />
    <path class="ah-face-smile" d="M17.6 21.2 Q20 23.1 22.4 21.2" />
</svg>

