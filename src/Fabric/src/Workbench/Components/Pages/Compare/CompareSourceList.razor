@inherits WorkbenchComponentBase
@* The page's sources, numbered as the table cites them: each one's name, its address and the day it was read, with the page's
   own date where it gives one (seo-geo.md, section 4.5: every fact links its source and says when it was read). *@

<ol class="csl">
    @for (var i = 0; i < Sources.Length; i++)
    {
        var source = Sources[i];
        <li @key="source.Id" id="@ComparePage.AnchorOf(source.Id)" class="csl-item">
            <span class="csl-number">@(i + 1)</span>
            <div class="csl-words">
                <span class="csl-name">@source.Name</span>
                @foreach (var url in source.Urls)
                {
                    <BitLink Href="@url" Target="_blank" Class="csl-url"><bdi>@Shown(url)</bdi></BitLink>
                }
                <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary">
                    @(source.PageDate is { } date
                        ? Localizer["Read on {0}. The page is dated {1}.", CompareShared.ReadOn, date]
                        : Localizer["Read on {0}.", CompareShared.ReadOn])
                </BitText>
            </div>
        </li>
    }
</ol>
