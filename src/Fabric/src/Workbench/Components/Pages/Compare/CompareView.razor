@inherits DirectionComponentBase
@* One comparison page, the hub or a subject, built from the home page directions' blocks so the set reads as one site. The
   table option leads with the answer and the table; the fit option leads with who should choose which, and the same facts
   follow as a compact table. Both end the same way: what bit Fabric doesn't have, what it costs, questions, Get started,
   and every source. *@

@if (IsHub is false)
{
    <nav class="cv-crumbs" aria-label="@Localizer["Breadcrumb"]">
        <BitLink OnClick="() => OnOpen.InvokeAsync(HubComparison.Key)">
            <BitIcon IconName="@BitIconName.Back" Class="cv-back-icon" />
            @Localizer["All comparisons"]
        </BitLink>
    </nav>
}

<DirectionHero Eyebrow="@Localizer["Checked on {0}", CompareShared.ReadOn]"
               TitleLines="@(IsFit ? Subject.FitTitle : Subject.TableTitle)"
               Lead="@(IsFit ? Subject.FitLead : Subject.Answer)"
               SecondaryText="@Localizer["Where each fact comes from"]"
               SecondaryHref="@InPage("sources")"
               SecondaryIcon="@BitIconName.ReportDocument" />

@if (IsFit)
{
    <DirectionBand Anchor="fit" Title="@Localizer["Which fits you"]">
        <DirectionLists Lists="ChoiceLists" MinWidth="@(IsHub ? "24rem" : "18rem")" IsLarge />
    </DirectionBand>
}

<DirectionBand Anchor="side-by-side" Title="@TableTitle">
    <DirectionTable LabelledBy="ah-side-by-side-title" Columns="Subject.Columns" ColumnNotes="Subject.ColumnNotes"
                    Rows="TableRows" Highlight="Subject.Columns.Length - 1" TopicWidth="@TopicWidth" IsLarge="@(IsHub is false)" />
    <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary" Element="p" Class="cv-source-line">@Subject.SourceLine</BitText>
</DirectionBand>

@if (IsHub)
{
    <DirectionBand Anchor="one-by-one" Title="@Localizer["Compared one by one"]"
                   Intro="@Localizer["Each page sets one of them next to bit Fabric, row by row, with every fact's source."]">
        <CompareCards Subjects="Subjects" OnOpen="OnOpen" />
    </DirectionBand>
}

@if (Subject.Extra is { } extra)
{
    <DirectionBand Anchor="more-than-code" Title="@extra.Title" Intro="@extra.Intro">
        <DirectionTiles Items="extra.Tiles" MinWidth="13rem" />
    </DirectionBand>
}

<DirectionBand Anchor="what-it-lacks" Title="@Localizer["What bit Fabric doesn't have"]"
               Intro="@Localizer["Said plainly, so nothing surprises you later."]">
    <DirectionTiles Items="Subject.Gaps" Look="DirectionTileLook.Outlined" MinWidth="14rem" />
</DirectionBand>

<DirectionBand Anchor="cost" Title="@Localizer["What bit Fabric costs"]"
               Answer="@Localizer["Starting is free during the beta. Running your app costs a server, a domain and the AI plan you already have."]"
               Note="@CompareShared.CostNote(Localizer)"
               NoteIcon="@BitIconName.Savings">
    <DirectionTiles Items="CompareShared.Costs(Localizer)" Look="DirectionTileLook.Figure" MinWidth="11rem" />
    <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary" Element="p">@CompareShared.CostSourceLine(Localizer)</BitText>
</DirectionBand>

<DirectionBand Anchor="questions" Title="@Localizer["Questions"]">
    <DirectionQuestions Items="Subject.Questions" />
</DirectionBand>

<DirectionFinal Title="@Localizer["See it for yourself"]"
                Text="@Localizer["Answer a few questions and paste one line. Your app opens on your computer, full featured, with every piece of it in your own accounts."]" />

<DirectionBand Anchor="sources" Title="@Localizer["Sources"]"
               Intro="@Localizer["Each page was read on {0}. The numbers in the table lead here.", CompareShared.ReadOn]">
    <CompareSourceList Ids="SourceIds" />
</DirectionBand>
