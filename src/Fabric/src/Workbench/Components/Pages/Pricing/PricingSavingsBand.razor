@* "Where a month's money goes": the same month on a hosted builder and with bit Fabric, in one of four designs, picked
   with the page's Saving switch. The amounts are in Data/PricingSavings.cs. *@
@inherits WorkbenchComponentBase

<div class="savings">
    @if (View == PricingSavings.Bills)
    {
        <div class="bills">
            <BitCard Outlined Class="bill-card">
                <div class="bill">
                    <BitText Typography="BitTypography.H6" Element="@HeadingElement">@builder.Name</BitText>
                    <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer["One bill"]</BitText>
                    <ul class="bill-lines">
                        <li class="bill-line">
                            <span class="bill-who">
                                <span class="bill-to">@Localizer["The builder"]</span>
                                <span class="bill-what">@Localizer["The AI, hosting, the database and its own share, in one price it sets"]</span>
                            </span>
                            <bdi class="bill-amount">@Euros(builder.Total)</bdi>
                        </li>
                    </ul>
                    <div class="bill-total">
                        <span>@Localizer["A month"]</span>
                        <bdi>@Euros(builder.Total)</bdi>
                    </div>
                </div>
            </BitCard>
            <BitCard Outlined Class="bill-card is-ours">
                <div class="bill">
                    <BitText Typography="BitTypography.H6" Element="@HeadingElement">@fabric.Name</BitText>
                    <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer["Each bill from whoever does the work"]</BitText>
                    <ul class="bill-lines">
                        @foreach (var part in fabric.Parts.Where(p => p.Kind is not PricingSavingKind.Kept))
                        {
                            <li @key="part.Label" class="bill-line">
                                <span class="dot @KindClass(part.Kind)" aria-hidden="true"></span>
                                <span class="bill-who">
                                    <span class="bill-to">@part.PaidTo</span>
                                    <span class="bill-what">@part.Label</span>
                                </span>
                                <bdi class="bill-amount">@Euros(part.Euros)</bdi>
                            </li>
                        }
                        @foreach (var (label, paidTo) in PricingSavings.FreeLines(Localizer))
                        {
                            <li @key="label" class="bill-line">
                                <span class="dot is-free" aria-hidden="true"></span>
                                <span class="bill-who">
                                    <span class="bill-to">@paidTo</span>
                                    <span class="bill-what">@label</span>
                                </span>
                                <bdi class="bill-amount">@Euros(0)</bdi>
                            </li>
                        }
                    </ul>
                    <div class="bill-total">
                        <span>@Localizer["A month"]</span>
                        <bdi>@Euros(fabric.Total)</bdi>
                    </div>
                    <BitTag Color="BitColor.Success" Variant="BitVariant.Fill" Text="@KeptText" Class="kept-tag" />
                </div>
            </BitCard>
        </div>
    }
    else if (View == PricingSavings.Table)
    {
        <div class="table-wrap">
            <table class="cost-table">
                <caption class="visually-hidden">@PricingSavings.Title(Localizer)</caption>
                <thead>
                    <tr>
                        <td></td>
                        <th scope="col">@builder.Name</th>
                        <th scope="col" class="is-ours">@fabric.Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in lines)
                    {
                        <tr @key="line.Label">
                            <th scope="row">
                                <span class="row-label"><span class="dot @KindClass(line.Kind)" aria-hidden="true"></span>@line.Label</span>
                            </th>
                            <td>
                                @if (line.BuilderNote is { } note)
                                {
                                    <bdi class="cell-amount">@BuilderAmount(line)</bdi>
                                    <span class="cell-note">@note</span>
                                }
                                else
                                {
                                    <span class="cell-none" aria-label="@Localizer["None"]">–</span>
                                }
                            </td>
                            <td class="is-ours">
                                <bdi class="cell-amount">@Euros(line.FabricEuros)</bdi>
                                <span class="cell-note">@line.FabricPaidTo</span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row">@Localizer["A month"]</th>
                        <td><bdi>@Euros(BuilderLinesTotal)</bdi></td>
                        <td class="is-ours"><bdi>@Euros(FabricLinesTotal)</bdi></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <BitTag Color="BitColor.Success" Variant="BitVariant.Fill" Text="@KeptText" Class="kept-tag" />
    }
    else if (View == PricingSavings.Bars)
    {
        <div class="bars">
            @foreach (var bar in (PricingSavingBar[])[builder, fabric])
            {
                <div @key="bar.Name" class="bar-row">
                    <div class="bar-head">
                        <BitText Typography="BitTypography.H6" Element="@HeadingElement">@bar.Name</BitText>
                        <bdi class="bar-total">@Localizer["{0} a month", Euros(bar.Total)]</bdi>
                    </div>
                    <div class="bar" role="img" aria-label="@Describe(bar)">
                        @foreach (var part in bar.Parts)
                        {
                            <span @key="part.Label" class="segment @KindClass(part.Kind)" style="flex-basis:@Width(part)"></span>
                        }
                    </div>
                    <ul class="legend">
                        @foreach (var part in bar.Parts)
                        {
                            <li @key="part.Label" class="legend-item">
                                <span class="dot @KindClass(part.Kind)" aria-hidden="true"></span>
                                <span>@part.Label</span>
                                <bdi class="legend-amount">@Euros(part.Euros)</bdi>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
    else
    {
        @* Row by row, the default: the same rows on both cards, so bit Fabric's is one row longer, for its license *@
        <div class="bills is-rows">
            <BitCard Outlined Class="bill-card">
                <div class="bill">
                    <BitText Typography="BitTypography.H6" Element="@HeadingElement">@builder.Name</BitText>
                    <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer["One bill, from the builder"]</BitText>
                    <ul class="bill-lines">
                        @foreach (var line in lines.Where(l => l.BuilderNote is not null))
                        {
                            <li @key="line.Label" class="bill-line">
                                <span class="dot @KindClass(line.Kind)" aria-hidden="true"></span>
                                <span class="bill-who">
                                    <span class="bill-to">@line.Label</span>
                                    <span class="bill-what">@line.BuilderNote</span>
                                </span>
                                <bdi class="bill-amount @(line.BuilderEuros is null ? "is-included" : null)">@BuilderAmount(line)</bdi>
                            </li>
                        }
                    </ul>
                    <div class="bill-total">
                        <span>@Localizer["A month"]</span>
                        <bdi>@Euros(BuilderLinesTotal)</bdi>
                    </div>
                </div>
            </BitCard>
            <BitCard Outlined Class="bill-card is-ours">
                <div class="bill">
                    <BitText Typography="BitTypography.H6" Element="@HeadingElement">@fabric.Name</BitText>
                    <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer["Each bill from whoever does the work"]</BitText>
                    <ul class="bill-lines">
                        @foreach (var line in lines)
                        {
                            <li @key="line.Label" class="bill-line @(line.BuilderNote is null ? "is-extra" : null)">
                                <span class="dot @KindClass(line.Kind)" aria-hidden="true"></span>
                                <span class="bill-who">
                                    <span class="bill-to">@line.Label</span>
                                    <span class="bill-what">@line.FabricPaidTo</span>
                                </span>
                                <bdi class="bill-amount">@Euros(line.FabricEuros)</bdi>
                            </li>
                        }
                    </ul>
                    <div class="bill-total">
                        <span>@Localizer["A month"]</span>
                        <bdi>@Euros(FabricLinesTotal)</bdi>
                    </div>
                    <BitTag Color="BitColor.Success" Variant="BitVariant.Fill" Text="@KeptText" Class="kept-tag" />
                </div>
            </BitCard>
        </div>
    }

    <ul class="why">
        @foreach (var line in PricingSavings.Why(Localizer))
        {
            <li @key="line" class="why-line">
                <BitIcon IconName="@BitIconName.CheckMark" Color="BitColor.Success" Size="BitSize.Small" Class="why-icon" />
                <BitText Typography="BitTypography.Body2">@line</BitText>
            </li>
        }
    </ul>

    <div class="honest">
        <BitIcon IconName="@BitIconName.Info" Color="BitColor.Info" Class="honest-icon" />
        <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@PricingSavings.Honest(Localizer)</BitText>
    </div>
</div>
