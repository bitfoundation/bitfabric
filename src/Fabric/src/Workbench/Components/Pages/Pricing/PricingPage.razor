@* bitfabric.co/pricing, one design option per business strategy (bitfabric-internal/.agents/gtm/README.md). The prices
   live in Data, one class per strategy; the parts every option shares are written once in PricingShared. *@
@inherits SitePageHost

<div class="pricing">
    <section class="hero">
        <span class="eyebrow">@Localizer["Pricing"]</span>
        <BitText Typography="BitTypography.H2" Element="@PageHeadingElement" Class="hero-title">
            @* Each sentence on a line of its own, broken inside only where the screen is too narrow, as on the home page *@
            @foreach (var sentence in TitleSentences)
            {
                <span class="hero-line">@sentence</span>
            }
        </BitText>
        <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary" Class="hero-lead">@Strategy.Lead</BitText>
    </section>

    <section class="plans" aria-label="@Localizer["Plans"]">
        <div class="plans-head">
            @if (Strategy.HasYearly)
            {
                <BitButtonGroup TItem="BitButtonGroupOption" Toggle FixedToggle Rounded Variant="BitVariant.Outline"
                                AriaLabel="@Localizer["Billing"]" ToggleKey="@(IsYearly ? Yearly : Monthly)" ToggleKeyChanged="SetBilling">
                    <BitButtonGroupOption Key="@Monthly" Text="@Localizer["Monthly"]" />
                    <BitButtonGroupOption Key="@Yearly" Text="@(MonthsOff is { } months ? Localizer["Yearly, {0} months off", months] : Localizer["Yearly"])" />
                </BitButtonGroup>
            }
            <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary" Class="plans-basis">@Strategy.Basis</BitText>
        </div>

        <PricingPlanCards Plans="Strategy.Plans" IsYearly="IsYearly" HeadingElement="@BandHeading" ContactUrl="@ContactUrl"
                          SeatsLeft="seatsLeft" IsLoadingSeats="isLoadingSeats" />

        @if (Strategy.UnderPlans is { } under)
        {
            <PricingTiles Tiles="[under]" HeadingElement="@BandHeading" IsRow />
        }

        @if (Strategy.Offer is { } offer)
        {
            <div class="offer">
                <BitIcon IconName="@BitIconName.Rocket" Variant="BitVariant.Fill" Circular Class="offer-icon" />
                <div class="offer-words">
                    <BitText Typography="BitTypography.H6" Element="@BandHeading">@offer.Title</BitText>
                    <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">@offer.Text</BitText>
                </div>
                <BitButton Variant="BitVariant.Outline" Href="@ContactUrl">@offer.Action</BitButton>
            </div>
        }

        @if (Strategy.Alternative is { } alternative)
        {
            <PricingTable Alternative="alternative" HeadingElement="@BandHeading" />
        }
    </section>

    @if (Strategy.Samples is { Length: > 0 } samples)
    {
        <section class="band">
            <header class="band-head">
                <BitText Typography="BitTypography.H4" Element="@BandHeading">@Localizer["Who pays what"]</BitText>
                <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">@Localizer["A few examples, to find yourself in."]</BitText>
            </header>
            <PricingTiles Tiles="samples" HeadingElement="@CardHeading" />
        </section>
    }

    <section class="band">
        <header class="band-head">
            <BitText Typography="BitTypography.H4" Element="@BandHeading">@PricingSavings.Title(Localizer)</BitText>
            <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">@PricingSavings.Lead(Localizer)</BitText>
        </header>
        <PricingSavingsBand View="@SavingView" HeadingElement="@CardHeading" />
    </section>

    @if (Strategy.Extra is { } extra)
    {
        <section class="band">
            <header class="band-head">
                <BitText Typography="BitTypography.H4" Element="@BandHeading">@extra.Title</BitText>
                <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">@extra.Text</BitText>
            </header>
            <PricingTiles Tiles="extra.Tiles" HeadingElement="@CardHeading" />
        </section>
    }

    @if (Strategy.CloudIncluded is { } included)
    {
        <section class="band">
            <header class="band-head">
                <BitText Typography="BitTypography.H4" Element="@BandHeading">@Localizer["Once your app is live"]</BitText>
                <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">@Localizer["Watching your live app comes with every plan above."]</BitText>
            </header>
            <PricingTiles Tiles="CloudTiles(included)" HeadingElement="@CardHeading" IsRow />
        </section>
    }

    <section class="band">
        <header class="band-head">
            <BitText Typography="BitTypography.H4" Element="@BandHeading">@Localizer["What stays true, whatever you pay"]</BitText>
        </header>
        <PricingTiles Tiles="PricingShared.Truths(Localizer)" HeadingElement="@CardHeading" />
    </section>

    <section class="band">
        <header class="band-head">
            <BitText Typography="BitTypography.H4" Element="@BandHeading">@Localizer["What you pay others"]</BitText>
            <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">@Localizer["bit Fabric is one line of your bill. Here are the others, written out."]</BitText>
        </header>
        <PricingTiles Tiles="PricingShared.Others(Localizer)" HeadingElement="@CardHeading" />
        <div class="note">
            <BitIcon IconName="@BitIconName.Savings" Color="BitColor.Primary" Class="note-icon" />
            <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@PricingShared.OthersNote(Localizer)</BitText>
        </div>
    </section>

    <section class="band">
        <header class="band-head">
            <BitText Typography="BitTypography.H4" Element="@BandHeading">@Localizer["Questions"]</BitText>
        </header>
        <div class="faq">
            @foreach (var question in Strategy.Questions)
            {
                <BitAccordion @key="question.Question" Title="@question.Question" HeadingLevel="CardLevel" HiddenUntilFound>
                    <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">@question.Answer</BitText>
                </BitAccordion>
            }
        </div>
    </section>

    <section class="final">
        <BitText Typography="BitTypography.H4" Element="@BandHeading">@Localizer["Answer a few questions, paste one line."]</BitText>
        <BitText Typography="BitTypography.Body1" Foreground="BitColorKind.Secondary">@Localizer["Your app starts full featured on your computer, and runs on your own server."]</BitText>
        <BitButton Href="@PageUrls.NewProject" IconName="@BitIconName.Rocket">@Localizer["Get started"]</BitButton>
    </section>
</div>
