@* The plans as cards to compare at a glance: a row on wide screens, stacked on a phone. *@
@inherits WorkbenchComponentBase

<div class="cards-wrap">
<ul class="cards">
    @foreach (var plan in Plans)
    {
        var amount = AmountOf(plan);
        var isHighlighted = plan.Highlight is not null;

        <li @key="plan.Key" class="card-cell">
            <BitCard Outlined FullSize Selected="isHighlighted" Class="card">
                <div class="card-body">
                    @* The tag's row is kept on every card of a row, so their names and prices line up *@
                    <div class="card-tag">@if (plan.Highlight is { } highlight)
                        {
                            <BitTag Text="@highlight" Size="BitSize.Small" Variant="BitVariant.Fill" Color="BitColor.Primary" />
                        }</div>
                    <BitText Typography="BitTypography.H5" Element="@HeadingElement">@plan.Name</BitText>
                    <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@plan.Audience</BitText>

                    <p class="price">
                        @if (amount.IsFrom)
                        {
                            <span class="price-from">@Localizer["from"]</span>
                        }
                        <bdi dir="ltr" class="price-amount">@Euros(amount.Euros)</bdi>
                        @if (PeriodOf(amount) is { } period)
                        {
                            <span class="price-period">@period</span>
                        }
                    </p>

                    @* Always there, empty or not, so the buttons of a row of cards line up *@
                    <div class="price-notes">
                        @foreach (var note in NotesOf(plan))
                        {
                            <BitText Typography="BitTypography.Caption1" Foreground="BitColorKind.Secondary">@note</BitText>
                        }
                    </div>

                    @* A count that couldn't be read says nothing, and takes no room *@
                    @if (plan.CountsSeats && (IsLoadingSeats || SeatsLeft is not null))
                    {
                        <div class="seats" aria-live="polite">
                            @if (IsLoadingSeats)
                            {
                                <BitShimmer Height="2.5rem" />
                            }
                            else if (SeatsLeft is 0)
                            {
                                <BitText Typography="BitTypography.Body2" Foreground="BitColorKind.Secondary">@Localizer["All {0} founding seats are taken.", MemberPricing.FoundingSeats]</BitText>
                            }
                            else if (SeatsLeft is { } left)
                            {
                                <BitProgress Percent="100.0 * left / MemberPricing.FoundingSeats" Label="@Localizer["{0} of {1} left", left, MemberPricing.FoundingSeats]" />
                            }
                        </div>
                    }

                    <BitButton FullWidth Variant="@(isHighlighted ? BitVariant.Fill : BitVariant.Outline)" Href="@HrefOf(plan)" Disabled="IsOpen(plan) is false">
                        @plan.ActionText
                    </BitButton>

                    @if (plan.Includes.Length > 0)
                    {
                        <ul class="includes">
                            @foreach (var line in plan.Includes)
                            {
                                <li>
                                    <BitIcon IconName="@BitIconName.CheckMark" Color="BitColor.Primary" Class="include-mark" />
                                    <span>@line</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </BitCard>
        </li>
    }
</ul>
</div>
