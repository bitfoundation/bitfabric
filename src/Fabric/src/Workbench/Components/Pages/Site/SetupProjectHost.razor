{
    <div class="placeholder" aria-busy="true">
        <BitShimmer Height="3rem" Radius="0.75rem" />
        <BitShimmer Height="18rem" Radius="0.75rem" />
    </div>
}
else
{
    <Bit.Fabric.Client.Core.Components.Pages.SetupProject.SetupProjectPage />
}
