@inherits WorkbenchComponentBase

<header class="shell-header">
    <a class="brand" href="@(Section is WorkbenchSection.Home ? WorkbenchUrls.HomeTop : WorkbenchUrls.Home)" aria-label="@Localizer[nameof(WorkbenchStrings.WorkbenchTitle)]">
        <img src="_content/Bit.Fabric.Client.Core/images/bit-logo.svg" alt="" width="26" height="26" />
        <span>@Localizer[nameof(WorkbenchStrings.WorkbenchTitle)]</span>
    </a>

    @* A bar of the sections on wider screens, and one button that opens them on a phone. *@
    <SectionNav Section="Section" Waiting="reviewSession.NeedsYouCount" Class="section-nav" />
    <SectionMenu Section="Section" Waiting="reviewSession.NeedsYouCount" Size="BitSize.Small" Class="section-menu" />

    <BitSpacer />

    @Actions

    @if (Section is not WorkbenchSection.Progress)
    {
        <span class="progress-shortcut">
            <BitBadge Content="@(reviewSession.NeedsYouCount)" Hidden="reviewSession.NeedsYouCount == 0" Color="BitColor.Warning" Overlap Size="BitSize.Small">
                <BitButton IconOnly Variant="BitVariant.Text" Size="BitSize.Small"
                           IconName="@BitIconName.TaskList"
                           Href="@WorkbenchUrls.Progress"
                           Title="@Localizer[nameof(WorkbenchStrings.Progress)]"
                           AriaLabel="@Localizer[nameof(WorkbenchStrings.Progress)]" />
            </BitBadge>
        </span>
    }

    <LanguageMenu Size="BitSize.Small" />

    <SoundToggle Size="BitSize.Small" />

    <BitButton IconOnly Variant="BitVariant.Text" Size="BitSize.Small"
               IconName="@BitIconName.Contrast"
               Title="@Localizer[nameof(WorkbenchStrings.ToggleWorkbenchTheme)]"
               AriaLabel="@Localizer[nameof(WorkbenchStrings.ToggleWorkbenchTheme)]"
               OnClick="ToggleTheme" />
</header>
